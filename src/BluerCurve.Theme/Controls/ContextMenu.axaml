<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bc="clr-namespace:BluerCurve.Primitives"
                    x:ClassModifier="internal">
  <Thickness x:Key="BcContextMenuPadding">3,4</Thickness>

  <ControlTheme x:Key="{x:Type ContextMenu}"
                TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource BcBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BcBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Padding" Value="{StaticResource BcContextMenuPadding}" />
    <Setter Property="TextBlock.FontSize" Value="{DynamicResource FontSizeNormal}" />
    <Setter Property="TextBlock.FontWeight" Value="Normal" />
    <Setter Property="Template">
      <ControlTemplate>
        <bc:BevelBorder Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Bevel="Raised"
                        LightBrush="{DynamicResource BcBevelLightBrush}"
                        DarkBrush="{DynamicResource BcBevelDarkBrush}">
          <ScrollViewer Theme="{DynamicResource BcMenuScrollViewer}">
            <ItemsPresenter Name="PART_ItemsPresenter"
                            Grid.IsSharedSizeScope="True"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue" />
          </ScrollViewer>
        </bc:BevelBorder>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
