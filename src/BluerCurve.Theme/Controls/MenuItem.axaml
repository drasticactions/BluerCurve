<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Controls.Converters"
                    xmlns:sys="using:System"
                    xmlns:bc="clr-namespace:BluerCurve.Primitives"
                    x:ClassModifier="internal">
  <conv:PlatformKeyGestureConverter x:Key="KeyGestureConverter" />

  <Thickness x:Key="BcMenuItemInnerPadding">5,2,4,2</Thickness>
  <Thickness x:Key="BcMenuSeparatorMargin">6,4,6,6</Thickness>
  <Thickness x:Key="BcMenuItemPopupPadding">3,4</Thickness>
  <ControlTheme x:Key="BcMenuScrollButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="{DynamicResource BcBgBrush}" />
    <Setter Property="MinHeight" Value="14" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <bc:BevelBorder Name="PART_Bevel"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource BcBorderBrush}"
                        BorderThickness="1"
                        Bevel="Raised"
                        LightBrush="{DynamicResource BcBevelLightBrush}"
                        DarkBrush="{DynamicResource BcBevelDarkBrush}">
          <Path Name="PART_Arrow"
                Width="7"
                Height="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="{TemplateBinding Content}"
                Fill="{DynamicResource BcButtonIconBrush}" />
        </bc:BevelBorder>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ bc|BevelBorder#PART_Bevel">
      <Setter Property="Background" Value="{DynamicResource BcPrelightBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Path#PART_Arrow">
      <Setter Property="Fill" Value="{DynamicResource BcButtonIconHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ bc|BevelBorder#PART_Bevel">
      <Setter Property="Background" Value="{DynamicResource BcDarkerBrush}" />
      <Setter Property="Bevel" Value="Sunken" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="BcMenuScrollViewer"
                TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="IsScrollChainingEnabled" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <RepeatButton Theme="{StaticResource BcMenuScrollButton}"
                        Command="{Binding LineUp, RelativeSource={RelativeSource TemplatedParent}}"
                        DockPanel.Dock="Top"
                        Content="{StaticResource BcArrowUpGeometry}">
            <RepeatButton.IsVisible>
              <MultiBinding Converter="{x:Static conv:MenuScrollingVisibilityConverter.Instance}"
                            ConverterParameter="0">
                <Binding Path="VerticalScrollBarVisibility"
                         RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="Offset.Y"
                         RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="Extent.Height"
                         RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="Viewport.Height"
                         RelativeSource="{RelativeSource TemplatedParent}" />
              </MultiBinding>
            </RepeatButton.IsVisible>
          </RepeatButton>
          <RepeatButton Theme="{StaticResource BcMenuScrollButton}"
                        Command="{Binding LineDown, RelativeSource={RelativeSource TemplatedParent}}"
                        DockPanel.Dock="Bottom"
                        Content="{StaticResource BcArrowDownGeometry}">
            <RepeatButton.IsVisible>
              <MultiBinding Converter="{x:Static conv:MenuScrollingVisibilityConverter.Instance}"
                            ConverterParameter="100">
                <Binding Path="VerticalScrollBarVisibility"
                         RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="Offset.Y"
                         RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="Extent.Height"
                         RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="Viewport.Height"
                         RelativeSource="{RelativeSource TemplatedParent}" />
              </MultiBinding>
            </RepeatButton.IsVisible>
          </RepeatButton>
          <ScrollContentPresenter Name="PART_ContentPresenter"
                                  Margin="{TemplateBinding Padding}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type MenuItem}"
                TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource BcFgBrush}" />
    <Setter Property="Padding" Value="{StaticResource BcMenuItemInnerPadding}" />
    <Setter Property="Template">
      <ControlTemplate>
        <bc:BevelBorder Name="root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Bevel="Raised"
                        LightBrush="Transparent"
                        DarkBrush="Transparent">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="5" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto"
                                SharedSizeGroup="MenuItemIGT" />
              <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0"
                            x:Name="PART_ToggleIconPresenter"
                            IsVisible="False"
                            Margin="3"
                            Width="16"
                            Height="16" />
            <ContentControl Grid.Column="0"
                            Name="PART_IconPresenter"
                            Width="16"
                            Height="16"
                            Margin="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Icon}" />
            <ContentPresenter Name="PART_HeaderPresenter"
                              Grid.Column="2"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}">
              <ContentPresenter.DataTemplates>
                <DataTemplate DataType="sys:String">
                  <AccessText Text="{Binding}" />
                </DataTemplate>
              </ContentPresenter.DataTemplates>
            </ContentPresenter>
            <TextBlock x:Name="PART_InputGestureText"
                       Grid.Column="3"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}"
                       Text="{TemplateBinding InputGesture,
                                              Converter={StaticResource KeyGestureConverter}}" />
            <Path Name="rightArrow"
                  Grid.Column="4"
                  Width="4"
                  Height="7"
                  Margin="6,0,0,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="{StaticResource BcArrowRightGeometry}"
                  Fill="{DynamicResource BcButtonIconBrush}" />
            <Popup Name="PART_Popup"
                   IsLightDismissEnabled="False"
                   IsOpen="{TemplateBinding IsSubMenuOpen,
                                            Mode=TwoWay}"
                   Placement="RightEdgeAlignedTop">
              <bc:BevelBorder Background="{DynamicResource BcBgBrush}"
                              BorderBrush="{DynamicResource BcBorderBrush}"
                              BorderThickness="1"
                              Bevel="Raised"
                              LightBrush="{DynamicResource BcBevelLightBrush}"
                              DarkBrush="{DynamicResource BcBevelDarkBrush}"
                              Padding="{StaticResource BcMenuItemPopupPadding}">
                <ScrollViewer Theme="{StaticResource BcMenuScrollViewer}">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  Grid.IsSharedSizeScope="True"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </bc:BevelBorder>
            </Popup>
          </Grid>
        </bc:BevelBorder>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:separator">
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Margin="{StaticResource BcMenuSeparatorMargin}">
            <Border Height="1" Background="{DynamicResource BcSeparatorDarkerBrush}" />
            <Border Height="1" Background="{DynamicResource BcBevelLightBrush}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource BcSelectedFgBrush}" />
    </Style>
    <Style Selector="^:selected /template/ bc|BevelBorder#root">
      <Setter Property="Background" Value="{DynamicResource BcMenuItemGradientBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BcMenuItemBorderBrush}" />
      <Setter Property="LightBrush" Value="{DynamicResource BcMenuItemLightBrush}" />
      <Setter Property="DarkBrush" Value="{DynamicResource BcMenuItemDarkBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Path#rightArrow">
      <Setter Property="Fill" Value="{DynamicResource BcSelectedFgBrush}" />
    </Style>

    <Style Selector="^:empty /template/ Path#rightArrow">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource BcInsensitiveFgBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#rightArrow">
      <Setter Property="Fill" Value="{DynamicResource BcInsensitiveFgBrush}" />
    </Style>

    <Style Selector="^:toggle /template/ ContentControl#PART_ToggleIconPresenter, ^:radio /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:toggle /template/ ContentControl#PART_IconPresenter, ^:radio /template/ ContentControl#PART_IconPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:checked:toggle /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="Content">
        <Template>
          <Path Width="13"
                Height="13"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="{StaticResource BcCheckGeometry}"
                Fill="{Binding $parent[MenuItem].Foreground}" />
        </Template>
      </Setter>
    </Style>
    <Style Selector="^:checked:radio /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="Content">
        <Template>
          <Path Width="7"
                Height="7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="{StaticResource BcRadioDotSmallGeometry}"
                Fill="{Binding $parent[MenuItem].Foreground}" />
        </Template>
      </Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>
