<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bc="clr-namespace:BluerCurve.Primitives"
                    xmlns:chrome="clr-namespace:BluerCurve.Chrome"
                    x:ClassModifier="internal">

  <ControlTheme x:Key="{x:Type chrome:TitleBarBackground}" TargetType="chrome:TitleBarBackground">
    <Setter Property="ActiveBrush" Value="{DynamicResource BcTitleActiveGradientBrush}" />
    <Setter Property="InactiveBrush" Value="{DynamicResource BcTitleInactiveGradientBrush}" />
    <Setter Property="StripeColor" Value="{DynamicResource BcTitleStripeColor}" />
    <Setter Property="StripeSoftColor" Value="{DynamicResource BcTitleStripeSoftColor}" />
    <Setter Property="StripeCoverBrush" Value="{DynamicResource BcTitleStripeCoverBrush}" />
    <Setter Property="ShineBrush" Value="{DynamicResource BcTitleShineBrush}" />
    <Setter Property="BottomLineBrush" Value="{DynamicResource BcTitleBottomLineBrush}" />
    <Setter Property="EdgeLineBrush" Value="{DynamicResource BcTitleEdgeLineBrush}" />
    <Setter Property="InactiveHighlightBrush" Value="{DynamicResource BcTitleInactiveHighlightBrush}" />
    <Setter Property="InactiveBottomLineBrush" Value="{DynamicResource BcTitleInactiveBottomLineBrush}" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type chrome:CaptionButton}" TargetType="chrome:CaptionButton">
    <Setter Property="Width" Value="{DynamicResource BcCaptionButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource BcCaptionButtonHeight}" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{DynamicResource BcCaptionButtonGradientBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BcCaptionButtonBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BcCaptionGlyphBrush}" />
    <Setter Property="(WindowDecorationProperties.ElementRole)" Value="DecorationsElement" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Outer"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="1.5" />
          <bc:BevelBorder Name="PART_Face"
                          Margin="1"
                          BorderThickness="0"
                          Bevel="Raised"
                          Background="{TemplateBinding Background}"
                          LightBrush="{DynamicResource BcCaptionButtonInnerLightBrush}"
                          DarkBrush="{DynamicResource BcCaptionButtonInnerDarkBrush}" />
          <Path Name="PART_Glyph"
                Width="9" Height="9"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{TemplateBinding Foreground}"
                Data="{TemplateBinding Glyph}" />
          <Path Name="PART_StrokeGlyph"
                Width="9" Height="9"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="2.2"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Data="{TemplateBinding StrokeGlyph}" />
          <Path Name="PART_GlyphBack"
                Width="9" Height="9"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0.7"
                IsVisible="False"
                Fill="{TemplateBinding Foreground}"
                Data="{StaticResource BcCaptionRestoreBackGeometry}" />
          <Border Name="PART_Tint" Margin="1" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Tint">
      <Setter Property="Background" Value="{DynamicResource BcCaptionButtonPrelightTintBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Outer">
      <Setter Property="BorderBrush" Value="{DynamicResource BcCaptionButtonBorderHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Path#PART_Glyph">
      <Setter Property="Fill" Value="{DynamicResource BcCaptionGlyphHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Path#PART_StrokeGlyph">
      <Setter Property="Stroke" Value="{DynamicResource BcCaptionGlyphHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Tint">
      <Setter Property="Background" Value="{DynamicResource BcCaptionButtonPressedTintBrush}" />
    </Style>

    <Style Selector="^:inactive /template/ bc|BevelBorder#PART_Face">
      <Setter Property="Background" Value="{DynamicResource BcCaptionButtonInactiveGradientBrush}" />
      <Setter Property="LightBrush" Value="Transparent" />
      <Setter Property="DarkBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:inactive /template/ Border#PART_Outer">
      <Setter Property="BorderBrush" Value="{DynamicResource BcCaptionButtonInactiveBorderBrush}" />
    </Style>
    <Style Selector="^:inactive /template/ Path#PART_Glyph">
      <Setter Property="Fill" Value="{DynamicResource BcCaptionGlyphInactiveBrush}" />
    </Style>
    <Style Selector="^:inactive /template/ Path#PART_GlyphBack">
      <Setter Property="Fill" Value="{DynamicResource BcCaptionGlyphInactiveBrush}" />
    </Style>
    <Style Selector="^:inactive /template/ Path#PART_StrokeGlyph">
      <Setter Property="Stroke" Value="{DynamicResource BcCaptionGlyphInactiveBrush}" />
    </Style>

    <Style Selector="^.maximize:maximized /template/ Path#PART_Glyph">
      <Setter Property="Data" Value="{StaticResource BcCaptionRestoreGeometry}" />
    </Style>
    <Style Selector="^.maximize:maximized /template/ Path#PART_GlyphBack">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type chrome:WindowMenuButton}" TargetType="chrome:WindowMenuButton" BasedOn="{StaticResource {x:Type chrome:CaptionButton}}">
    <Setter Property="StrokeGlyph" Value="{StaticResource BcCaptionMenuStrokeGeometry}" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type chrome:TitleBarPod}" TargetType="chrome:TitleBarPod">
    <Setter Property="Background" Value="{DynamicResource BcTitlePodGradientBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BcTitlePodSideBrush}" />
    <Setter Property="Padding" Value="5,0,5,0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="(WindowDecorationProperties.ElementRole)" Value="TitleBar" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_PodBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Border Name="PART_PodBottom"
                  BorderBrush="{DynamicResource BcTitlePodBottomBrush}"
                  BorderThickness="0,0,0,1">
            <ContentPresenter Name="PART_ContentPresenter"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.left">
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="CornerRadius" Value="4,0,0,0" />
    </Style>
    <Style Selector="^.right">
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="CornerRadius" Value="0,4,0,0" />
    </Style>
    <Style Selector="^:maximized">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^:inactive">
      <Setter Property="Background" Value="{DynamicResource BcTitlePodInactiveGradientBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BcTitlePodInactiveSideBrush}" />
    </Style>
    <Style Selector="^:inactive /template/ Border#PART_PodBottom">
      <Setter Property="BorderBrush" Value="{DynamicResource BcTitleInactiveBottomLineBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="BcTitleTextBlock" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource BcTitleTextBrush}" />
  </ControlTheme>
</ResourceDictionary>
