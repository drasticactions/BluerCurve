<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bc="clr-namespace:BluerCurve.Primitives"
                    x:ClassModifier="internal">
  <Thickness x:Key="BcAutoCompleteBoxPopupPadding">4,3</Thickness>

  <ControlTheme x:Key="{x:Type AutoCompleteBox}"
                TargetType="AutoCompleteBox">
    <Setter Property="Background" Value="{DynamicResource BcBaseBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BcTextBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource BcInsensitiveFgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BcBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource ThemeBorderThickness}" />
    <Setter Property="Padding" Value="{DynamicResource BcEntryPadding}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <TextBox Name="PART_TextBox"
                   Padding="{TemplateBinding Padding}"
                   Background="{TemplateBinding Background}"
                   Foreground="{TemplateBinding Foreground}"
                   BorderBrush="{TemplateBinding BorderBrush}"
                   BorderThickness="{TemplateBinding BorderThickness}"
                   CaretIndex="{TemplateBinding CaretIndex, Mode=TwoWay}"
                   ClearSelectionOnLostFocus="{TemplateBinding ClearSelectionOnLostFocus}"
                   DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                   PlaceholderText="{TemplateBinding PlaceholderText}"
                   PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                   MaxLength="{TemplateBinding MaxLength}"
                   InnerLeftContent="{TemplateBinding InnerLeftContent}"
                   InnerRightContent="{TemplateBinding InnerRightContent}"
                   />

          <Popup Name="PART_Popup"
                 MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                 MaxHeight="{TemplateBinding MaxDropDownHeight}"
                 IsLightDismissEnabled="True"
                 PlacementTarget="{TemplateBinding}">
            <bc:BevelBorder Background="{DynamicResource BcBgBrush}"
                            BorderBrush="{DynamicResource BcBorderBrush}"
                            BorderThickness="1"
                            Bevel="Raised"
                            LightBrush="{DynamicResource BcBevelLightBrush}"
                            DarkBrush="{DynamicResource BcBevelDarkBrush}"
                            Padding="{StaticResource BcAutoCompleteBoxPopupPadding}">
              <ListBox Name="PART_SelectingItemsControl"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{DynamicResource BcFgBrush}"
                       ItemTemplate="{TemplateBinding ItemTemplate}"
                       ScrollViewer.IsScrollChainingEnabled="False"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </bc:BevelBorder>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
