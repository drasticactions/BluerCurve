<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:bc="clr-namespace:BluerCurve.Primitives"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Width="500">
      <StackPanel Spacing="8">
        <CommandBar>
          <CommandBarButton Label="New">
            <CommandBarButton.Icon>
              <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
            </CommandBarButton.Icon>
          </CommandBarButton>
          <CommandBarButton Label="Save">
            <CommandBarButton.Icon>
              <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" />
            </CommandBarButton.Icon>
          </CommandBarButton>
        </CommandBar>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <Thickness x:Key="BcToolbarPadding">1,0</Thickness>
  <Thickness x:Key="BcToolbarButtonPadding">3</Thickness>
  <Thickness x:Key="BcToolbarSeparatorMargin">6</Thickness>
  <Thickness x:Key="BcToolbarItemsMargin">0,3</Thickness>
  <Thickness x:Key="BcToolbarOverflowPadding">3,4</Thickness>
  <sys:Double x:Key="BcToolbarButtonWidthBottom">56</sys:Double>
  <sys:Double x:Key="BcToolbarButtonWidthCompact">26</sys:Double>
  <ControlTheme x:Key="BcToolbarOverflowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{StaticResource BcToolbarButtonPadding}" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Margin" Value="{StaticResource BcToolbarItemsMargin}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <bc:BevelBorder Name="PART_Bevel"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Bevel="Raised"
                        LightBrush="Transparent"
                        DarkBrush="Transparent">
          <Path Name="PART_Arrow"
                Width="7"
                Height="4"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="{TemplateBinding Content}"
                Fill="{DynamicResource BcButtonIconBrush}" />
        </bc:BevelBorder>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ bc|BevelBorder#PART_Bevel">
      <Setter Property="Background" Value="{DynamicResource BcPrelightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BcDarkerBorderBrush}" />
      <Setter Property="LightBrush" Value="{DynamicResource BcBevelLightBrush}" />
      <Setter Property="DarkBrush" Value="{DynamicResource BcBevelDarkBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Path#PART_Arrow">
      <Setter Property="Fill" Value="{DynamicResource BcBlackBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ bc|BevelBorder#PART_Bevel">
      <Setter Property="Background" Value="{DynamicResource BcDarkerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BcDarkerBorderBrush}" />
      <Setter Property="Bevel" Value="Sunken" />
      <Setter Property="LightBrush" Value="{DynamicResource BcBevelLightBrush}" />
      <Setter Property="DarkBrush" Value="{DynamicResource BcBevelDarkBrush}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type CommandBarButton}" TargetType="CommandBarButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource BcFgBrush}" />
    <Setter Property="Padding" Value="{StaticResource BcToolbarButtonPadding}" />
    <Setter Property="Width" Value="{StaticResource BcToolbarButtonWidthBottom}" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <bc:BevelBorder x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Bevel="Raised"
                        LightBrush="Transparent"
                        DarkBrush="Transparent"
                        Padding="{TemplateBinding Padding}">
          <StackPanel x:Name="PART_LayoutRoot"
                      Spacing="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <ContentPresenter x:Name="PART_IconPresenter"
                              Content="{TemplateBinding Icon}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            <TextBlock x:Name="PART_Label"
                       Text="{TemplateBinding Label}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </bc:BevelBorder>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ bc|BevelBorder#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BcPrelightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BcDarkerBorderBrush}" />
      <Setter Property="LightBrush" Value="{DynamicResource BcBevelLightBrush}" />
      <Setter Property="DarkBrush" Value="{DynamicResource BcBevelDarkBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ bc|BevelBorder#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BcDarkerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BcDarkerBorderBrush}" />
      <Setter Property="Bevel" Value="Sunken" />
      <Setter Property="LightBrush" Value="{DynamicResource BcBevelLightBrush}" />
      <Setter Property="DarkBrush" Value="{DynamicResource BcBevelDarkBrush}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource BcInsensitiveFgBrush}" />
    </Style>

    <Style Selector="^[IsCompact=True]">
      <Setter Property="Width" Value="{StaticResource BcToolbarButtonWidthCompact}" />
    </Style>
    <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^[LabelPosition=Right]">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="24" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="0" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="2,0,8,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[IsInOverflow=True]:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource BcSelectedFgBrush}" />
    </Style>
    <Style Selector="^[IsInOverflow=True]:pointerover /template/ bc|BevelBorder#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BcMenuItemGradientBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BcMenuItemBorderBrush}" />
      <Setter Property="LightBrush" Value="{DynamicResource BcMenuItemLightBrush}" />
      <Setter Property="DarkBrush" Value="{DynamicResource BcMenuItemDarkBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CommandBarToggleButton}" TargetType="CommandBarToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource BcFgBrush}" />
    <Setter Property="Padding" Value="{StaticResource BcToolbarButtonPadding}" />
    <Setter Property="Width" Value="{StaticResource BcToolbarButtonWidthBottom}" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <bc:BevelBorder x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Bevel="Raised"
                        LightBrush="Transparent"
                        DarkBrush="Transparent"
                        Padding="{TemplateBinding Padding}">
          <StackPanel x:Name="PART_LayoutRoot"
                      Spacing="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <ContentPresenter x:Name="PART_IconPresenter"
                              Content="{TemplateBinding Icon}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            <TextBlock x:Name="PART_Label"
                       Text="{TemplateBinding Label}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </bc:BevelBorder>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ bc|BevelBorder#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BcPrelightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BcDarkerBorderBrush}" />
      <Setter Property="LightBrush" Value="{DynamicResource BcBevelLightBrush}" />
      <Setter Property="DarkBrush" Value="{DynamicResource BcBevelDarkBrush}" />
    </Style>

    <Style Selector="^:pressed /template/ bc|BevelBorder#PART_Border, ^:checked /template/ bc|BevelBorder#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BcDarkerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BcDarkerBorderBrush}" />
      <Setter Property="Bevel" Value="Sunken" />
      <Setter Property="LightBrush" Value="{DynamicResource BcBevelLightBrush}" />
      <Setter Property="DarkBrush" Value="{DynamicResource BcBevelDarkBrush}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource BcInsensitiveFgBrush}" />
    </Style>
    <Style Selector="^:disabled:checked /template/ bc|BevelBorder#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BcInsensitiveBgBrush}" />
    </Style>

    <Style Selector="^[IsCompact=True]">
      <Setter Property="Width" Value="{StaticResource BcToolbarButtonWidthCompact}" />
    </Style>
    <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^[LabelPosition=Right]">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="24" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="0" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="2,0,8,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[IsInOverflow=True]:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource BcSelectedFgBrush}" />
    </Style>
    <Style Selector="^[IsInOverflow=True]:pointerover /template/ bc|BevelBorder#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BcMenuItemGradientBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BcMenuItemBorderBrush}" />
      <Setter Property="LightBrush" Value="{DynamicResource BcMenuItemLightBrush}" />
      <Setter Property="DarkBrush" Value="{DynamicResource BcMenuItemDarkBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CommandBarSeparator}" TargetType="CommandBarSeparator">
    <Setter Property="Background" Value="{DynamicResource BcMediumBorderBrush}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="MinHeight" Value="12" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="{StaticResource BcToolbarSeparatorMargin}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                MinHeight="{TemplateBinding MinHeight}" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="6,4,6,6" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <Border Height="1" Background="{DynamicResource BcSeparatorDarkerBrush}" />
            <Border Height="1" Background="{DynamicResource BcWhiteBrush}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CommandBar}" TargetType="CommandBar">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource BcBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BcTroughBgBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Foreground" Value="{DynamicResource BcFgBrush}" />
    <Setter Property="Padding" Value="{StaticResource BcToolbarPadding}" />
    <Setter Property="ItemWidthBottom" Value="56" />
    <Setter Property="ItemWidthRight" Value="80" />
    <Setter Property="ItemWidthCollapsed" Value="28" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                MinHeight="{TemplateBinding MinHeight}">
          <Border BorderBrush="{DynamicResource BcLightBorderBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="{TemplateBinding Padding}">
            <Panel>
              <DockPanel KeyboardNavigation.TabNavigation="Cycle">
                <Button x:Name="PART_OverflowButton"
                        Theme="{StaticResource BcToolbarOverflowButton}"
                        DockPanel.Dock="Right"
                        IsVisible="{TemplateBinding IsOverflowButtonVisible}"
                        Content="{StaticResource BcArrowDownGeometry}" />

                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  DockPanel.Dock="Left"
                                  VerticalAlignment="Center" />

                <ItemsControl x:Name="PART_PrimaryCommands"
                              ItemsSource="{Binding VisiblePrimaryCommands, RelativeSource={RelativeSource TemplatedParent}}"
                              Margin="{StaticResource BcToolbarItemsMargin}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"
                              ClipToBounds="True">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="0" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </DockPanel>

              <Popup x:Name="PART_OverflowPopup"
                     IsOpen="{TemplateBinding IsOpen, Mode=TwoWay}"
                     PlacementTarget="{Binding #PART_OverflowButton}"
                     Placement="Bottom"
                     IsLightDismissEnabled="True">
                <bc:BevelBorder Background="{DynamicResource BcBgBrush}"
                                BorderBrush="{DynamicResource BcBorderBrush}"
                                BorderThickness="1"
                                Bevel="Raised"
                                LightBrush="{DynamicResource BcBevelLightBrush}"
                                DarkBrush="{DynamicResource BcBevelDarkBrush}"
                                Padding="{StaticResource BcToolbarOverflowPadding}"
                                MinWidth="160">
                  <ItemsControl x:Name="PART_OverflowPresenter"
                                ItemsSource="{Binding OverflowItems, RelativeSource={RelativeSource TemplatedParent}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="0" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </bc:BevelBorder>
              </Popup>
            </Panel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
