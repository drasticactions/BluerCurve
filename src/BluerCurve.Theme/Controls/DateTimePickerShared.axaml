<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:bc="clr-namespace:BluerCurve.Primitives"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Width="200"
            Padding="20">
      <StackPanel Spacing="20">
        <ListBoxItem Theme="{DynamicResource BcDateTimePickerItem}">Standard Item</ListBoxItem>
        <ListBoxItem Theme="{DynamicResource BcDateTimePickerItem}" Classes="MonthItem">Month Item</ListBoxItem>
        <RepeatButton Theme="{DynamicResource BcDateTimePickerButton}">Button</RepeatButton>
        <RepeatButton Theme="{DynamicResource BcDateTimePickerUpButton}" IsVisible="True"/>
        <RepeatButton Theme="{DynamicResource BcDateTimePickerDownButton}" IsVisible="True"/>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <x:Double x:Key="BcDateTimePickerItemHeight">24</x:Double>
  <x:Double x:Key="BcDateTimePickerStepperHeight">15</x:Double>
  <x:Double x:Key="BcDateTimePickerAcceptDismissHeight">24</x:Double>
  <Thickness x:Key="BcDateTimePickerFlyoutPadding">4,3</Thickness>
  <Thickness x:Key="BcDateTimePickerItemPadding">6,0,5,0</Thickness>
  <Thickness x:Key="BcDateTimePickerMonthItemPadding">9,0,5,0</Thickness>

  <ControlTheme x:Key="BcDateTimePickerItem"
                TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource BcFgBrush}" />
    <Setter Property="Padding" Value="{DynamicResource BcDateTimePickerItemPadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          Background="{TemplateBinding Background}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          TextElement.Foreground="{TemplateBinding Foreground}" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BcPrelightBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource BcSelectedFgBrush}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.MonthItem">
      <Setter Property="Padding" Value="{DynamicResource BcDateTimePickerMonthItemPadding}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="BcDateTimePickerButton"
                TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource BcBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BcDarkerBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BcButtonIconBrush}" />
    <Setter Property="Height" Value="{DynamicResource BcDateTimePickerAcceptDismissHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <bc:BevelBorder Name="PART_Bevel"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        Bevel="Raised"
                        LightBrush="{DynamicResource BcBevelLightBrush}"
                        DarkBrush="{DynamicResource BcBevelDarkBrush}">
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
        </bc:BevelBorder>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ bc|BevelBorder#PART_Bevel">
      <Setter Property="Background" Value="{DynamicResource BcPrelightBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource BcBlackBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ bc|BevelBorder#PART_Bevel">
      <Setter Property="Background" Value="{DynamicResource BcDarkerBrush}" />
      <Setter Property="Bevel" Value="Sunken" />
    </Style>
    <Style Selector="^:disabled /template/ bc|BevelBorder#PART_Bevel">
      <Setter Property="Background" Value="{DynamicResource BcInsensitiveBgBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource BcInsensitiveFgBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="BcDateTimePickerUpButton"
                BasedOn="{StaticResource BcDateTimePickerButton}"
                TargetType="RepeatButton">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Height" Value="{DynamicResource BcDateTimePickerStepperHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Content">
      <Template>
        <Path Width="7" Height="4" Data="{StaticResource BcArrowUpGeometry}" Fill="{Binding $parent[RepeatButton].Foreground}" />
      </Template>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="BcDateTimePickerDownButton"
                BasedOn="{StaticResource BcDateTimePickerButton}"
                TargetType="RepeatButton">
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Height" Value="{DynamicResource BcDateTimePickerStepperHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Content">
      <Template>
        <Path Width="7" Height="4" Data="{StaticResource BcArrowDownGeometry}" Fill="{Binding $parent[RepeatButton].Foreground}" />
      </Template>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
