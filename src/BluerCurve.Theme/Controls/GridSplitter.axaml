<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <x:Double x:Key="BcGridSplitterThickness">6</x:Double>

  <ControlTheme x:Key="{x:Type GridSplitter}"
                TargetType="GridSplitter">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="MinWidth" Value="{DynamicResource BcGridSplitterThickness}" />
    <Setter Property="MinHeight" Value="{DynamicResource BcGridSplitterThickness}" />
    <Setter Property="Background" Value="{DynamicResource BcBgBrush}" />
    <Setter Property="PreviewContent">
      <Template>
        <Rectangle Fill="{DynamicResource BcSelectedBgBrush}" />
      </Template>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Handle"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Handle">
      <Setter Property="Background" Value="{DynamicResource BcPrelightBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
